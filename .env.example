# FlashStudy AI - Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Groq API Key - get yours free at https://console.groq.com
GROQ_API_KEY=

# Upstash Redis - get yours free at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your deployed Vercel app URL (set after first deploy)
# Example: https://flashstudy-ai.vercel.app
NEXT_PUBLIC_APP_URL=
